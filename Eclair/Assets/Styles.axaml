<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="DockPanel.rounded > Button">
        <Setter Property="Background" Value="Transparent"/>
            
        <Style Selector="^:nth-child(1)">
            <Setter Property="CornerRadius" Value="50 0 0 50"/>
        </Style>
            
        <Style Selector="^:nth-last-child(1)">
            <Setter Property="CornerRadius" Value="0 50 50 0"/>
        </Style>
            
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Style>
    
    <Style Selector="ListBox.tracks > ListBoxItem">
        <Style Selector="^:selected /template/ ContentPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.2" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Background" Value="Transparent"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Background" Value="{StaticResource AccentButtonBackground}"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:selected) /template/ ContentPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.2" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Background" Value="{StaticResource AccentButtonBackground}"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Background" Value="Transparent"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Style>
</Styles>

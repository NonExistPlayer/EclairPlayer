<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
			 xmlns:l="clr-namespace:Eclair"
             xmlns:v="clr-namespace:Eclair.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Eclair.ViewModels"
             xmlns:core="clr-namespace:Eclair.Core;assembly=Eclair.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Eclair.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*">
    <Menu>
      <MenuItem Header="{l:Localize MenuFile}">
        <MenuItem Header="{l:Localize MenuFileOpen}" Click="Open_Click"/>
      </MenuItem>
    </Menu>
    
    <i:Icon Grid.Row="0" Value="fa-plane-up" Animation="Spin"/>

    <TextBox Grid.Row="1"
             Text="yep, this is placeholder"
             Margin="5"/>
    
    <Grid Grid.Row="2"
          ColumnDefinitions="2*, *">
        <StackPanel VerticalAlignment="Center">
            <Image Source="{Binding ImageSource}"
                   MaxHeight="256"/>
            <TextBlock Text="{Binding Title}"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Performers}"
                       FontSize="18"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Album}"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
            
            <Border CornerRadius="50"
                    Margin="25"
                    Background="{DynamicResource AltBackground}"
                    HorizontalAlignment="Center">
                <DockPanel Classes="rounded">
                    <Button i:Attached.Icon="{x:Static vm:MainViewModel.PrevIconValue}"
                            FontSize="{x:Static vm:MainViewModel.FontSize}"
                            Click="Prev_Click"/>
                    <Button Content="{Binding PlayIcon}"
                            Click="Play_Click"/>
                    <Button i:Attached.Icon="{x:Static vm:MainViewModel.NextIconValue}"
                            FontSize="{x:Static vm:MainViewModel.FontSize}"
                            Click="Next_Click"/>
                </DockPanel>
            </Border>
        </StackPanel>
        
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">
            <TextBlock Text="{l:Localize Tracks}"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            
            <ListBox Grid.Row="1"
                     Focusable="False"
                     SelectionMode="Multiple"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ItemsSource="{Binding Playlist}"
                     SelectedItems="{Binding SelectedItems}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Localize TracksContextRemove}"
                                  Click="TracksContext_Remove"
                                  HotKey="Delete"/>
                    </ContextMenu>
                </ListBox.ContextMenu>                
                
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
    
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button FontSize="18"
                                    CornerRadius="20"
                                    Click="List_Play_Click"
                                    Tag="{Binding}"
                                    Background="Transparent"
                                    i:Attached.Icon="{x:Static vm:MainViewModel.CirclePlayIconValue}"/>
                            <TextBlock Text="{Binding FileName}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
  </Grid>
</UserControl>

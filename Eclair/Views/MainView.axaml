<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Eclair.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Eclair.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid>
    <Grid.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Grid.Styles>
    <Grid.RowDefinitions>
      <RowDefinition Height="33"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="100"/>
    </Grid.RowDefinitions>

    <Grid>
      <TextBox Text="yep, this is placeholder"/>
    </Grid>

    <Border Grid.Row="1"
     BorderBrush="Gray"
     BorderThickness="1">
      <TextBlock Text="tracks placeholder"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"/>
    </Border>

    <DockPanel Grid.Row="2"
     Background="Gray">
     <StackPanel VerticalAlignment="Center"
      Orientation="Horizontal"
      Margin="5 0"
      Spacing="10">
      <TextBlock Text="img"/>
      <TextBlock Text="Author - Track"/>
     </StackPanel>

     <StackPanel
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="5 0"
      Spacing="10">
        <Button Name="PlayButton" Content="{Binding PlayIcon}"/>
        <Button Name="NextButton" Content="{Binding NextIcon}"/>
     </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
